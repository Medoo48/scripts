#!/bin/sh

mkdir res 2>/dev/null

# Перетворити JSON-файл на звичайний текст
if [ $1 == 'json' ]; then
	shift #json
	for arg in "$@"
	do
		text=$(cat $arg | sed -E "s/^.*: \"//g;
					  s/^  \{//g;
					  s/^  },//g;
					  s/^  }//g;
					  s/^\[//g;
					  s/^]//g;
					  s/\"$//g")

		text=$(sed -E -z 's/\n+/\n/g' <<< "$text")

		echo "$text" > res/$arg.text.txt
	done
	exit 0
fi

# Оптимізувати кількість символів у файлах
if [ $1 == 'prep' ]; then
	shift #prep
	for arg in "$@"
	do
		text=$(cat $arg | sed -E "s/, /,/g;
					  s/\.$//;
					  s/, -/,-/g;
					  s/, —/,—/g;
					  s/\? /?/g;
					  s/! /!/g;
					  s/; /;/g")

		text=$(sed -E -z 's/\n+/\n/g' <<< "$text")

		echo "$text" > res/$arg.prep.txt
	done
	exit 0
fi


